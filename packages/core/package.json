{
  "name": "@lazy-promise/core",
  "version": "0.0.36",
  "description": "A Promise-like primitive which is lazy, cancelable, emits synchronously instead of in a microtask, and supports typed errors and dependency injection",
  "repository": {
    "type": "git",
    "url": "https://github.com/lazy-promise/lazy-promise.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/types/index.d.ts",
      "default": "./build/module/index.js"
    }
  },
  "types": "build/types/index.d.ts",
  "files": [
    "build/module",
    "build/types"
  ],
  "scripts": {
    "build:clean": "rm -rf build",
    "build:force": "tsc -p tsconfig.build.json --noEmitOnError false || true",
    "build:module": "tsc --build tsconfig.build.json",
    "test:eslint": "eslint . --max-warnings=0",
    "test:typescript": "tsc",
    "test:vitest": "vitest run"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.0.3",
    "@types/web": "0.0.342",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^8.57.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
