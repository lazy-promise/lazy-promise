{
  "name": "@lazy-promise/alien-signals",
  "version": "0.0.9",
  "description": "Async signals built on top of alien-signals and LazyPromise",
  "repository": {
    "type": "git",
    "url": "https://github.com/lazy-promise/lazy-promise.git",
    "directory": "packages/alien-signals"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/types/index.d.ts",
      "default": "./build/module/index.js"
    }
  },
  "types": "build/types/index.d.ts",
  "files": [
    "build/module",
    "build/types"
  ],
  "scripts": {
    "build:clean": "rm -rf build",
    "build:force": "tsc -p tsconfig.build.json --noEmitOnError false || true",
    "build:module": "tsc --build tsconfig.build.json",
    "test:eslint": "eslint . --max-warnings=0",
    "test:typescript": "tsc",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "@lazy-promise/core": "workspace:*",
    "alien-signals": "3.2.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.0.3",
    "@types/web": "0.0.342",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^8.57.0",
    "reactive-framework-test-suite": "0.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
