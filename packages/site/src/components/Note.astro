---
// Callout box for MDX pages; children are rendered as Markdown.
---

<aside class="note">
  <div class="note-title">
    <svg
      class="note-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M21 9a2.4 2.4 0 0 0-.706-1.706l-3.588-3.588A2.4 2.4 0 0 0 15 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2z"></path>
      <path d="M15 3v5a1 1 0 0 0 1 1h5"></path>
    </svg>
    Note
  </div>
  <div class="note-body">
    <slot />
  </div>
</aside>
